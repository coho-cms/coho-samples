# Where the service reads its content, and with which credential. Copy this file to .env,
# which git ignores, and fill it in. Run the service with: uv run --env-file .env fastapi dev
#
# A preview: dev or a branch, read live through Coho with a project token.
COHO_URL=https://api-dev.coho-cms.dev
COHO_ACCOUNT=
COHO_PROJECT=
COHO_REF=dev
COHO_LOCALE=en-US
COHO_PREVIEW_TOKEN=
