# dev: the head of the trunk, read live through Coho, for `npm run dev`.
# Nothing here is secret, so it is committed. Fill in the account and project ids
# from `coho status`, or copy them from the .env.local you made for blog-try.
COHO_URL=https://api-dev.coho-cms.dev
COHO_ACCOUNT=
COHO_PROJECT=
COHO_REF=dev
COHO_LOCALE=en-US

# The project token is a secret, so it goes in .env.local, which is never committed:
# COHO_PREVIEW_TOKEN=coho_pt_…
